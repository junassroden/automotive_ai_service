# Copy to .env (never commit .env). settings.py reads this file; real environment variables take precedence.

# A long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# True only for local development. With False, a real DJANGO_SECRET_KEY is required.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# Behind an HTTPS proxy only (the Back-End reaches this service over plain HTTP on localhost):
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000

# Shared secret (at least 32 characters); must equal AI_SERVICE_API_KEY in Back-End/.env.
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(36))"
AI_SERVICE_API_KEY=change-this-to-a-long-random-key-of-32-or-more-chars
CHATBOT_MODEL_PATH=trained_models/chatbot_nlp.joblib
# Conversation memory unused for this many days is deleted (also: python manage.py purge_conversations).
CHAT_MEMORY_RETENTION_DAYS=30
